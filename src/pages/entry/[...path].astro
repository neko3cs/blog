---
import { getCollection, render } from 'astro:content';
import BaseLayout, { SITE_TITLE } from '../../layouts/BaseLayout.astro';
import { toDescription } from '../../lib/description';

export async function getStaticPaths() {
  const entries = await getCollection('entries', ({ data }) => !data.Draft);
  return entries.map((entry) => ({
    // はてなの元URLのパスをそのまま出力先にする
    // https://blog.neko3cs.net/entry/2020/03/30/002449 → "2020/03/30/002449"
    params: { path: new URL(entry.data.URL).pathname.replace(/^\/entry\//, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { Title, Category, Date: publishedAt } = entry.data;

const dateLabel = publishedAt.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'Asia/Tokyo',
});
---

<BaseLayout
  title={`${Title} - ${SITE_TITLE}`}
  description={toDescription(entry.body ?? '')}
  type="article"
  publishedTime={publishedAt}
>
  <main>
    <header class="mx-auto max-w-[820px] px-6 pt-20 pb-12 text-center md:pt-28 md:pb-16">
      <p class="mb-5 text-sm font-semibold tracking-wide text-text-sub">
        {Category.join(' · ')}
      </p>
      <h1 class="apple-heading-m text-balance">{Title}</h1>
      <time datetime={publishedAt.toISOString()} class="mt-6 block text-sm text-text-sub">
        {dateLabel}
      </time>
    </header>

    <article class="mx-auto max-w-[860px] px-4 pb-24 md:px-6">
      <div class="rounded-[28px] bg-bg-card px-6 py-12 md:px-16 md:py-20">
        <div class="article-body mx-auto max-w-[692px]">
          <Content />
        </div>

        {
          Category.length > 0 && (
            <div class="mx-auto mt-16 flex max-w-[692px] flex-wrap gap-2 border-t border-border/60 pt-8">
              {Category.map((name) => (
                <a href={`/archive/category/${encodeURIComponent(name)}`} class="apple-pill">
                  {name}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </article>
  </main>
</BaseLayout>
