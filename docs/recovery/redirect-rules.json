{
  "rules": [
    {
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "preserve_query_string": true,
          "status_code": 301,
          "target_url": {
            "expression": "wildcard_replace(http.request.full_uri, r\"https://neko3cs.net/*\", r\"https://portfolio.neko3cs.net/${1}\")"
          }
        }
      },
      "description": "Redirect to portfolio.neko3cs.net from neko3cs.net",
      "enabled": true,
      "expression": "(http.request.full_uri wildcard r\"https://neko3cs.net/*\")"
    },
    {
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "preserve_query_string": true,
          "status_code": 301,
          "target_url": {
            "expression": "wildcard_replace(http.request.full_uri, r\"https://www.neko3cs.net/*\", r\"https://portfolio.neko3cs.net/${1}\")"
          }
        }
      },
      "description": " Redirect to portfolio.neko3cs.net from www.neko3cs.net",
      "enabled": true,
      "expression": "(http.request.full_uri wildcard r\"https://www.neko3cs.net/*\")"
    },
    {
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "preserve_query_string": false,
          "status_code": 301,
          "target_url": {
            "expression": "wildcard_replace(http.request.full_uri, r\"https://www.neko3cs.net/*\", r\"https://blog.neko3cs.net/${1}\")"
          }
        }
      },
      "description": "Redirect to blog.neko3cs.net from www.neko3cs.net",
      "enabled": false,
      "expression": "(http.request.full_uri wildcard r\"https://www.neko3cs.net/*\")"
    }
  ]
}
