# Cloudflare Workers Static Assets のレスポンスヘッダー
# はてなブログと同じく拡張子のないURLでフィードを提供するため、Content-Type を明示する

/feed
  Content-Type: application/atom+xml; charset=utf-8

/rss
  Content-Type: application/rss+xml; charset=utf-8

# 記事の管理画面（Sveltia CMS、Issue #20）。検索に載せず、他のサイトに埋め込まれないようにする。
# 読み込み先は、Sveltia CMS の配布元（unpkg.com）、そのフォント（cdn.jsdelivr.net）、
# GitHub の API・ステータス、OAuth の受け口（workers/cms-auth）だけに絞る。
/admin
  X-Robots-Tag: noindex
/admin/*
  X-Robots-Tag: noindex
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self' https://unpkg.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src https://cdn.jsdelivr.net data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' data: blob: https://api.github.com https://www.githubstatus.com https://neko3cs-blog-cms-auth.neko3cs.workers.dev https://cdn.jsdelivr.net https://unpkg.com; worker-src 'self' blob:; frame-src 'self' blob: https:; base-uri 'none'; object-src 'none'; form-action 'self'; frame-ancestors 'none'

# プレビュー（*.workers.dev）は本番と同じ内容の重複になるため、検索エンジンに載せない
# ホスト名で絞っているので、本番（blog.neko3cs.net）には付かない
https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
